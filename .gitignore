# OS
.DS_Store
Thumbs.db
desktop.ini

# Debug / temp scripts (per-ticket, not for distribution)
skills/deep-analysis/scripts/_*

# Env (v2.3: 存放 MX_APIKEY 等敏感凭据，绝不 commit)
.env
.env.local
.env.*.local
*.local.env
*.key
# .env.example 必须保留入库（仅示例，无凭据）
!.env.example

# v3.4.1 · 防御性 ignore：cookies / session / 私人状态文件
**/cookies.json
**/.uzi-skill/
*.pem
*.p12
id_rsa*
.netrc

# Local-only drafts (not for remote)
docs/wechat-article.md
docs/*.local.md

.claude-plugin
.codex
.cursor-plugin
.github
.opencode
.reasonix

# v2.10.2 · prewarm_cache 生成的预热数据（release 附件，不进 repo）
skills/deep-analysis/scripts/prewarm/

# ---- Node / Electron / Vite 前端 ----
node_modules/
# electron-builder 输出（win-unpacked、安装包 exe、blockmap 等，见 client/package.json build.directories.output）
dist-electron/
**/dist-electron/
# tsc -b 增量编译产物（client/web 构建链）
*.tsbuildinfo

# 桌面端运行时产物（client/server.py 生成的分析任务记录，含本机绝对路径）
client/data/jobs/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地工具配置（含机器级绝对路径权限，勿入库；.reasonix/ 已在上方忽略）
reasonix.toml
